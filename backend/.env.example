# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=courier_db

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Frontend URL (CORS) ──────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
